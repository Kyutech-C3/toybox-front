{
  "name": "toybox-2025",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npx biome lint ./src",
    "check:naming": "node check-naming-conventions.js",
    "fix:naming": "node check-naming-conventions.js --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "ci": "npm run check:naming && npx biome check ./src ./biome.json ./package.json ./tsconfig.json ./tsconfig.app.json ./tsconfig.node.json && npm run build",
    "format": "npx biome check --write ./src ./biome.json ./package.json ./tsconfig.json ./tsconfig.app.json ./tsconfig.node.json",
    "prepare": "husky",
    "new:ui": "hygen generator ui",
    "new:feature": "hygen generator feature",
    "new:component": "hygen generator component"
  },
  "lint-staged": {
    "./src/**/*.{js,jsx,ts,tsx,css,json,jsonc}": "npx biome check --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@uiw/react-md-editor": "^4.1.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": "24.x",
    "yarn": "このプロジェクトではnpmを使用してください",
    "bun": "このプロジェクトではnpmを使用してください",
    "pnpm": "このプロジェクトではnpmを使用してください"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
